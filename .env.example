BOT_CREATOR_USERNAME=@HidEgoBot
MAIN_BOT_TOKEN=123456789:HDWUhuahhawudw7dhwui-dbabdba7dauawb
# For local development, use ngrok to create a secure tunnel:
# 1. Install ngrok
# 2. Run: ngrok http 13360
# 3. Copy the generated HTTPS URL (e.g., https://xxxx.ngrok.io)
# For production use Cloudflare Tunnel with custom domain
WEBHOOK_BASE_URL=https://abc12-34-567-890-64.ngrok-free.app
# To enhance security and check if webhooks set by our bot, generate a token and put it here
# https://core.telegram.org/bots/api#setwebhook
TG_SECRET_TOKEN=hadwadawda82e2huhdd7dhauid
LOG_FILENAME=Logs.log
# Timezone of Logging
LOGGER_TIMEZONE=Asia/Tehran
# Default FastAPI port (hIddEnEGO = "13360" leetspeak)
FASTAPI_PORT=13360
# Host address used to publish FASTAPI_PORT. Keep this on loopback so the bot
# is reachable only through Cloudflare Tunnel or a local reverse proxy.
# Never use 0.0.0.0: Docker's DNAT rules bypass UFW.
FASTAPI_BIND_ADDR=127.0.0.1
# Comma-separated proxy IPs/CIDRs allowed to set CF-Connecting-IP/X-Forwarded-For.
# 172.30.0.1 = Docker gateway (host-run cloudflared); 172.30.0.2 = cloudflared container.
TRUSTED_PROXY_CIDRS=172.30.0.1/32,172.30.0.2/32
# Legacy alias, still read when TRUSTED_PROXY_CIDRS is unset (comma-separated CIDRs):
# DOCKER_NETWORK_IP=172.30.0.1/32,172.30.0.2/32

# Infisical Configuration
INFISICAL_SECRET_NAME=ANONYMOUS_MASTER_PASSWORD
INFISICAL_CLIENT_ID=your_actual_client_id_here
INFISICAL_CLIENT_SECRET=your_actual_client_secret_here
INFISICAL_PROJECT_ID=your_actual_project_id_here
INFISICAL_ENVIRONMENT=prod

# --- Lean (low-end VPS) mode: fully opt-in, nothing applied by default ---
# Enable per run without editing any file or switching branches:
#   ./run.sh start --lean        or        LEAN_MODE=1 ./run.sh start
# This loads docker/docker-compose.lean.yml on top of the base compose file
# (RAM/CPU caps, memory-backed /tmp, lean uvicorn worker). Default runs stay
# full-performance. All values below are optional overrides; lean defaults
# live in the lean file itself.
# LEAN_MODE=0
# PYTHON_BASE=python:3.12-slim
# BOT_MEM_LIMIT=512m
# BOT_MEM_RESERVATION=128m
# BOT_CPUS=1.0
# TUNNEL_MEM_LIMIT=128m
# TUNNEL_MEM_RESERVATION=32m
# TUNNEL_CPUS=0.50
# UVICORN_EXTRA_ARGS=--workers 1 --loop uvloop --http httptools --timeout-keep-alive 5
